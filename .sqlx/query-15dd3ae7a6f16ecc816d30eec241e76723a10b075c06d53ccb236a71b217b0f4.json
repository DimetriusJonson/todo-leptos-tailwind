  "query": "\n                SELECT\n                    id AS \"id!: i32\",\n                    title,\n                    description,\n                    priority,\n                    completed_at AS \"completed_at!: Option<DateTime<FixedOffset>>\"\n                FROM tasks\n                    WHERE title = $1 and deleted_at is null and user_id=$2\n                ",
